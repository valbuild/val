# Content analytics, as the project setting would turn it on for a hosted site.
# Read by `fetchValAnalytics` in src/val/server.ts.
VAL_ANALYTICS=true
# The content version a hosted site is handed for each render. Local
# development has no versions, so this stands in for one: every beacon the
# showcase sends carries it as `cv`.
VAL_CONTENT_VERSION=showcase-dev
