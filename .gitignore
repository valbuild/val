.claude/worktrees/

# Playwright. Unanchored: a run started from a package directory writes its
# results there, not at the root, and an anchored pattern leaves those tracked.
test-results/
playwright-report/
blob-report/
playwright/.cache/
# Screenshots from e2e/screens.spec.ts: artifacts of a run, not a fixture.
screens/
