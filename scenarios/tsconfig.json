{
  "compilerOptions": {
    // The harness imports the Studio's stores from `packages/ui/spa` by path,
    // so it compiles them too, with the Studio's own settings.
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": ["node", "jest"],
    "strict": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    // As the Studio's: the assistant's code tools it compiles (`proposalCode`)
    // lint with `@valbuild/eslint-plugin`, which is JavaScript.
    "allowJs": true
  },
  "include": [
    "src/**/*",
    "measure/**/*",
    // The Studio's own globals (`window.__VAL_BASE__`), for its code the
    // harness compiles.
    "../packages/ui/spa/types/window.d.ts"
  ]
}
