{
  "compilerOptions": {
    // The harness imports the Studio's stores from `packages/ui/spa` by path,
    // so it compiles them too, with the Studio's own settings.
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": ["node", "jest"],
    "strict": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true
  },
  "include": ["src/**/*", "measure/**/*"]
}
