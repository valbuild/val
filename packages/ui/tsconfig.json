{
  "compilerOptions": {
    "esModuleInterop": true,
    "strict": true,
    "allowJs": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["es2020", "dom"],
    "module": "esnext",
    // "bundler" rather than "node": Vite resolves these sources, and the
    // Storybook 10 packages ship their types only through `exports` maps,
    // which the legacy node10 algorithm cannot read.
    "moduleResolution": "bundler",
    "noEmit": true,
    "target": "ES2015",
    "outDir": "dist",
    "rootDir": ".",
    "skipLibCheck": true,
    "baseUrl": "."
  },
  "include": ["spa/**/*", "src/**/*"]
}
