{
  "compilerOptions": {
    "esModuleInterop": true,
    // Declared, not auto-discovered: TypeScript 6 no longer includes every
    // @types package it can find, so leaving this unset loses the node and
    // jest globals. The packages are still resolved through the default
    // typeRoots walk up to the workspace root.
    "types": ["node", "jest"],
    "strict": true,
    "allowJs": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    // es2022 for the `new Error(message, { cause })` overload, which eslint
    // 10's `preserve-caught-error` rule asks for when rethrowing. This is a
    // type-only change: `Error.cause` needs no downlevel emit, and every
    // browser the Studio already requires (it uses `structuredClone`)
    // supports it.
    "lib": ["es2022", "dom"],
    "module": "esnext",
    // "bundler" rather than "node": Vite resolves these sources, and the
    // Storybook 10 packages ship their types only through `exports` maps,
    // which the legacy node10 algorithm cannot read.
    "moduleResolution": "bundler",
    "noEmit": true,
    "target": "ES2015",
    "outDir": "dist",
    "rootDir": ".",
    "skipLibCheck": true
  },
  "include": ["spa/**/*", "src/**/*"]
}
