exports[`patch groups who carries whom depends on the order publish then continue: the other author's remaining work still applies 1`] = `
"scenario: Bob renames, Alice inserts, Bob publishes, Alice carries on
module:   /content/page.val.ts
shape:    { title, items: [{ title }] }
base:     "Page" [A, B, C]
repair:   extend

1.  bob edits p1: replace items/1/title = "B*"
      intent      rename "B" to "B*"
      patch sets  ?items/1/title [p1]
      bob    {p1}             "Page" [A, B*, C]
      alice  {}               "Page" [A, B, C]

2.  alice edits p2: add items/0 = {"title":"New"}
      intent      insert "New" at the top
      patch sets  ?items [p1, p2]
      also staged p1 (bob) — required by p2
      bob    {p1}             "Page" [A, B*, C]
      alice  {p1, p2}         "Page" [New, A, B*, C]

3.  bob publishes [p1]
      alice's group loses the patches that were just committed
      new base    "Page" [A, B*, C]
      patch sets  ?items [p2]
      bob    {}               "Page" [A, B*, C]
      alice  {p2}             "Page" [New, A, B*, C]

4.  alice edits p3: replace items/3/title = "C*"
      intent      rename "C" to "C*"
      patch sets  ?items [p2, p3]
      bob    {}               "Page" [A, B*, C]
      alice  {p2, p3}         "Page" [New, A, B*, C*]

5.  alice publishes [p2, p3]
      new base    "Page" [New, A, B*, C*]
      patch sets  (none)
      bob    {}               "Page" [New, A, B*, C*]
      alice  {}               "Page" [New, A, B*, C*]"
`;
