// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`patch groups DECISION 1 — array co-editing entangles both authors once the first author returns to a shared array, neither can publish alone 1`] = `
"scenario: Bob edits the array, Alice edits it, then Bob edits it again
module:   /content/page.val.ts
shape:    { title, items: [{ title }] }
base:     "Page" [A, B, C]
repair:   extend

1.  bob edits p1: replace items/0/title = "A*"
      intent      rename "A" to "A*"
      patch sets  ?items/0/title [p1]
      bob    {p1}             "Page" [A*, B, C]
      alice  {}               "Page" [A, B, C]

2.  alice edits p2: add items/3 = {"title":"D"}
      intent      append "D"
      patch sets  ?items [p1, p2]
      also staged p1 (bob) — required by p2
      bob    {p1}             "Page" [A*, B, C]
      alice  {p1, p2}         "Page" [A*, B, C, D]

3.  bob edits p3: replace items/2/title = "C*"
      intent      rename "C" to "C*"
      patch sets  ?items [p1, p2, p3]
      also staged p2 (alice) — required by p3
      bob    {p1, p2, p3}     "Page" [A*, B, C*, D]
      alice  {p1, p2}         "Page" [A*, B, C, D]

if each author published now, from this same state:
  bob    commits [p1, p2, p3] — carries p2 (alice)
         "Page" [A*, B, C*, D]
  alice  commits [p1, p2] — carries p1 (bob)
         "Page" [A*, B, C, D]"
`;

exports[`patch groups DECISION 2 — repair policy when a merge invalidates a group extend: Alice keeps her change but now carries Bob's 1`] = `
"scenario: Bob edits item 0, Alice edits item 1, Carol inserts (repair: extend)
module:   /content/page.val.ts
shape:    { title, items: [{ title }] }
base:     "Page" [A, B, C]
repair:   extend

1.  bob edits p1: replace items/0/title = "A*"
      intent      rename "A" to "A*"
      patch sets  ?items/0/title [p1]
      bob    {p1}             "Page" [A*, B, C]
      alice  {}               "Page" [A, B, C]
      carol  {}               "Page" [A, B, C]

2.  alice edits p2: replace items/1/title = "B*"
      intent      rename "B" to "B*"
      patch sets  ?items/1/title [p2]   ?items/0/title [p1]
      bob    {p1}             "Page" [A*, B, C]
      alice  {p2}             "Page" [A, B*, C]
      carol  {}               "Page" [A, B, C]

3.  carol edits p3: add items/3 = {"title":"D"}
      intent      append "D"
      patch sets  ?items [p1, p2, p3]
      also staged p1 (bob), p2 (alice) — required by p3
      repaired alice's group +p1 — p3 changed the patch sets (policy: extend)
      bob    {p1}             "Page" [A*, B, C]
      alice  {p1, p2}         "Page" [A*, B*, C]
      carol  {p1, p2, p3}     "Page" [A*, B*, C, D]

if each author published now, from this same state:
  bob    commits [p1] — only their own work
         "Page" [A*, B, C]
  alice  commits [p1, p2] — carries p1 (bob)
         "Page" [A*, B*, C]
  carol  commits [p1, p2, p3] — carries p1 (bob), p2 (alice)
         "Page" [A*, B*, C, D]"
`;

exports[`patch groups DECISION 2 — repair policy when a merge invalidates a group truncate: Alice carries nobody, but loses her own change 1`] = `
"scenario: Bob edits item 0, Alice edits item 1, Carol inserts (repair: truncate)
module:   /content/page.val.ts
shape:    { title, items: [{ title }] }
base:     "Page" [A, B, C]
repair:   truncate

1.  bob edits p1: replace items/0/title = "A*"
      intent      rename "A" to "A*"
      patch sets  ?items/0/title [p1]
      bob    {p1}             "Page" [A*, B, C]
      alice  {}               "Page" [A, B, C]
      carol  {}               "Page" [A, B, C]

2.  alice edits p2: replace items/1/title = "B*"
      intent      rename "B" to "B*"
      patch sets  ?items/1/title [p2]   ?items/0/title [p1]
      bob    {p1}             "Page" [A*, B, C]
      alice  {p2}             "Page" [A, B*, C]
      carol  {}               "Page" [A, B, C]

3.  carol edits p3: add items/3 = {"title":"D"}
      intent      append "D"
      patch sets  ?items [p1, p2, p3]
      also staged p1 (bob), p2 (alice) — required by p3
      repaired alice's group -p2 — p3 changed the patch sets (policy: truncate)
      bob    {p1}             "Page" [A*, B, C]
      alice  {}               "Page" [A, B, C]
      carol  {p1, p2, p3}     "Page" [A*, B*, C, D]

if each author published now, from this same state:
  bob    commits [p1] — only their own work
         "Page" [A*, B, C]
  alice  nothing staged
  carol  commits [p1, p2, p3] — carries p1 (bob), p2 (alice)
         "Page" [A*, B*, C, D]"
`;

exports[`patch groups DECISION 3 — unstaging KNOWN HOLE: unstage then edit the same region corrupts the edit 1`] = `
"scenario: Alice unstages Bob's insert, then edits the array anyway
module:   /content/page.val.ts
shape:    { title, items: [{ title }] }
base:     "Page" [A, B, C]
repair:   extend

1.  bob edits p1: add items/0 = {"title":"New"}
      intent      insert "New" at the top
      patch sets  ?items [p1]
      bob    {p1}             "Page" [New, A, B, C]
      alice  {}               "Page" [A, B, C]

2.  alice unstages p1
      bob    {p1}             "Page" [New, A, B, C]
      alice  {}               "Page" [A, B, C]

3.  alice edits p2: replace items/1/title = "B*"
      intent      rename "B" to "B*"
      patch sets  ?items [p1, p2]
      also staged p1 (bob) — required by p2
      bob    {p1}             "Page" [New, A, B, C]
      alice  {p1, p2}         "Page" [New, B*, B, C]

if each author published now, from this same state:
  bob    commits [p1] — only their own work
         "Page" [New, A, B, C]
  alice  commits [p1, p2] — carries p1 (bob)
         "Page" [New, B*, B, C]"
`;

exports[`patch groups DECISION 3 — unstaging unstaging a patch also unstages what was built on top of it 1`] = `
"scenario: Alice unstages Bob's insert that her own edit depends on
module:   /content/page.val.ts
shape:    { title, items: [{ title }] }
base:     "Page" [A, B, C]
repair:   extend

1.  bob edits p1: add items/0 = {"title":"New"}
      intent      insert "New" at the top
      patch sets  ?items [p1]
      bob    {p1}             "Page" [New, A, B, C]
      alice  {}               "Page" [A, B, C]

2.  alice edits p2: replace items/2/title = "B*"
      intent      rename "B" to "B*"
      patch sets  ?items [p1, p2]
      also staged p1 (bob) — required by p2
      bob    {p1}             "Page" [New, A, B, C]
      alice  {p1, p2}         "Page" [New, A, B*, C]

3.  alice unstages p1
      also dropped p2 (alice) — they were built on top of it
      bob    {p1}             "Page" [New, A, B, C]
      alice  {}               "Page" [A, B, C]

if each author published now, from this same state:
  bob    commits [p1] — only their own work
         "Page" [New, A, B, C]
  alice  nothing staged"
`;

exports[`patch groups DECISION 3 — unstaging unstaging in a different patch set leaves the rest of the group alone 1`] = `
"scenario: Alice unstages one of her two unrelated edits, then publishes
module:   /content/page.val.ts
shape:    { title, items: [{ title }] }
base:     "Page" [A, B, C]
repair:   extend

1.  alice edits p1: replace title = "Page*"
      intent      retitle the page
      patch sets  ?title [p1]
      alice  {p1}             "Page*" [A, B, C]

2.  alice edits p2: replace items/2/title = "C*"
      intent      rename "C" to "C*"
      patch sets  ?items/2/title [p2]   ?title [p1]
      alice  {p1, p2}         "Page*" [A, B, C*]

3.  alice unstages p1
      alice  {p2}             "Page" [A, B, C*]

4.  alice publishes [p2]
      new base    "Page" [A, B, C*]
      patch sets  ?title [p1]
      alice  {}               "Page" [A, B, C*]"
`;

exports[`patch groups a move belongs to two patch sets moving between two arrays entangles both 1`] = `
"scenario: Bob edits todo, Carol edits done, Alice moves an item across
module:   /content/board.val.ts
shape:    { todo: [{ title }], done: [{ title }] }
base:     todo[T1, T2] done[D1]
repair:   extend

1.  bob edits p1: replace todo/0/title = "T1*"
      intent      rename "T1" to "T1*"
      patch sets  ?todo/0/title [p1]
      bob    {p1}             todo[T1*, T2] done[D1]
      carol  {}               todo[T1, T2] done[D1]
      alice  {}               todo[T1, T2] done[D1]

2.  carol edits p2: replace done/0/title = "D1*"
      intent      rename "D1" to "D1*"
      patch sets  ?done/0/title [p2]   ?todo/0/title [p1]
      bob    {p1}             todo[T1*, T2] done[D1]
      carol  {p2}             todo[T1, T2] done[D1*]
      alice  {}               todo[T1, T2] done[D1]

3.  alice edits p3: move done/1 from todo/1
      intent      move "T2" from todo to done
      patch sets  ?todo [p1, p3]   ?done [p2, p3]
      also staged p1 (bob), p2 (carol) — required by p3
      bob    {p1}             todo[T1*, T2] done[D1]
      carol  {p2}             todo[T1, T2] done[D1*]
      alice  {p1, p2, p3}     todo[T1*] done[D1*, T2]

if each author published now, from this same state:
  bob    commits [p1] — only their own work
         todo[T1*, T2] done[D1]
  carol  commits [p2] — only their own work
         todo[T1, T2] done[D1*]
  alice  commits [p1, p2, p3] — carries p1 (bob), p2 (carol)
         todo[T1*] done[D1*, T2]"
`;

