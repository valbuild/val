"scenario: Bob retitles record key "foo", Alice retitles "bar"
module:   /content/projects.val.ts
shape:    record of { title }
base:     {foo: Foo, bar: Bar}
repair:   extend

1.  bob edits p1: replace foo/title = "Foo*"
      intent      retitle "foo"
      picked in   {foo: Foo, bar: Bar}
      patch sets  ?foo/title [p1]
      bob    {p1}             {foo: Foo*, bar: Bar}
      alice  {p1}             {foo: Foo*, bar: Bar}

2.  alice edits p2: replace bar/title = "Bar*"
      intent      retitle "bar"
      picked in   {foo: Foo*, bar: Bar}
      patch sets  ?bar/title [p2]   ?foo/title [p1]
      bob    {p1, p2}         {foo: Foo*, bar: Bar*}
      alice  {p1, p2}         {foo: Foo*, bar: Bar*}

if each author published now, from this same state:
  bob    commits [p1, p2] — carries p2 (alice)
         {foo: Foo*, bar: Bar*}
  alice  commits [p1, p2] — carries p1 (bob)
         {foo: Foo*, bar: Bar*}"
`;

