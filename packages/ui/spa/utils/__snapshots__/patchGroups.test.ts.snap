// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`patch groups DECISION — repair policy when a merge invalidates a group extend: Alice's hold is overridden and she ships Bob's rename 1`] = `
"scenario: Alice holds Bob's rename, then Carol's insert swallows it (repair: extend)
module:   /content/page.val.ts
shape:    { title, items: [{ title }] }
base:     "Page" [A, B, C]
repair:   extend

1.  bob edits p1: replace items/1/title = "B*"
      intent      rename "B" to "B*"
      picked in   "Page" [A, B, C]
      patch sets  ?items/1/title [p1]
      bob    {p1}             "Page" [A, B*, C]
      alice  {p1}             "Page" [A, B*, C]
      carol  {p1}             "Page" [A, B*, C]

2.  alice unstages p1
      bob    {p1}             "Page" [A, B*, C]
      alice  {}               "Page" [A, B, C]   holds ?items/1/title [p1]
      carol  {p1}             "Page" [A, B*, C]

3.  alice edits p2: replace title = "Page*"
      intent      retitle the page
      picked in   "Page" [A, B, C]
      patch sets  ?title [p2]   ?items/1/title [p1]
      bob    {p1, p2}         "Page*" [A, B*, C]
      alice  {p2}             "Page*" [A, B, C]   holds ?items/1/title [p1]
      carol  {p1, p2}         "Page*" [A, B*, C]

4.  carol edits p3: add items/3 = {"title":"D"}
      intent      append "D"
      picked in   "Page*" [A, B*, C]
      patch sets  ?items [p1, p3]   ?title [p2]
      not staged for alice — they hold this region back
      bob    {p1, p2, p3}     "Page*" [A, B*, C, D]
      alice  {p2}             "Page*" [A, B, C]   holds ?items [p1,p3]
      carol  {p1, p2, p3}     "Page*" [A, B*, C, D]

if each author published now, from this same state:
  bob    commits [p1, p2, p3] — carries p2 (alice), p3 (carol)
         "Page*" [A, B*, C, D]
  alice  commits [p2] — only their own work
         "Page*" [A, B, C]
  carol  commits [p1, p2, p3] — carries p1 (bob), p2 (alice)
         "Page*" [A, B*, C, D]"
`;

exports[`patch groups DECISION — repair policy when a merge invalidates a group truncate: Alice's hold survives at the cost of dropping work 1`] = `
"scenario: Alice holds Bob's rename, then Carol's insert swallows it (repair: truncate)
module:   /content/page.val.ts
shape:    { title, items: [{ title }] }
base:     "Page" [A, B, C]
repair:   truncate

1.  bob edits p1: replace items/1/title = "B*"
      intent      rename "B" to "B*"
      picked in   "Page" [A, B, C]
      patch sets  ?items/1/title [p1]
      bob    {p1}             "Page" [A, B*, C]
      alice  {p1}             "Page" [A, B*, C]
      carol  {p1}             "Page" [A, B*, C]

2.  alice unstages p1
      bob    {p1}             "Page" [A, B*, C]
      alice  {}               "Page" [A, B, C]   holds ?items/1/title [p1]
      carol  {p1}             "Page" [A, B*, C]

3.  alice edits p2: replace title = "Page*"
      intent      retitle the page
      picked in   "Page" [A, B, C]
      patch sets  ?title [p2]   ?items/1/title [p1]
      bob    {p1, p2}         "Page*" [A, B*, C]
      alice  {p2}             "Page*" [A, B, C]   holds ?items/1/title [p1]
      carol  {p1, p2}         "Page*" [A, B*, C]

4.  carol edits p3: add items/3 = {"title":"D"}
      intent      append "D"
      picked in   "Page*" [A, B*, C]
      patch sets  ?items [p1, p3]   ?title [p2]
      not staged for alice — they hold this region back
      bob    {p1, p2, p3}     "Page*" [A, B*, C, D]
      alice  {p2}             "Page*" [A, B, C]   holds ?items [p1,p3]
      carol  {p1, p2, p3}     "Page*" [A, B*, C, D]

if each author published now, from this same state:
  bob    commits [p1, p2, p3] — carries p2 (alice), p3 (carol)
         "Page*" [A, B*, C, D]
  alice  commits [p2] — only their own work
         "Page*" [A, B, C]
  carol  commits [p1, p2, p3] — carries p1 (bob), p2 (alice)
         "Page*" [A, B*, C, D]"
`;

exports[`patch groups a region you have unstaged is read-only until you re-stage a new patch does not join a group that is holding its region 1`] = `
"scenario: Alice holds the array; Bob adds more to it
module:   /content/page.val.ts
shape:    { title, items: [{ title }] }
base:     "Page" [A, B, C]
repair:   extend

1.  bob edits p1: add items/0 = {"title":"Draft"}
      intent      insert "Draft" at the top
      picked in   "Page" [A, B, C]
      patch sets  ?items [p1]
      bob    {p1}             "Page" [Draft, A, B, C]
      alice  {p1}             "Page" [Draft, A, B, C]

2.  alice unstages p1
      bob    {p1}             "Page" [Draft, A, B, C]
      alice  {}               "Page" [A, B, C]   holds ?items [p1]

3.  bob edits p2: add items/4 = {"title":"Extra"}
      intent      append "Extra"
      picked in   "Page" [Draft, A, B, C]
      patch sets  ?items [p1, p2]
      not staged for alice — they hold this region back
      bob    {p1, p2}         "Page" [Draft, A, B, C, Extra]
      alice  {}               "Page" [A, B, C]   holds ?items [p1,p2]

if each author published now, from this same state:
  bob    commits [p1, p2] — only their own work
         "Page" [Draft, A, B, C, Extra]
  alice  nothing staged"
`;

exports[`patch groups a region you have unstaged is read-only until you re-stage editing a held region is refused rather than silently corrupted 1`] = `
"scenario: Alice unstages Bob's insert, then tries to edit that array
module:   /content/page.val.ts
shape:    { title, items: [{ title }] }
base:     "Page" [A, B, C]
repair:   extend

1.  bob edits p1: add items/0 = {"title":"Draft"}
      intent      insert "Draft" at the top
      picked in   "Page" [A, B, C]
      patch sets  ?items [p1]
      bob    {p1}             "Page" [Draft, A, B, C]
      alice  {p1}             "Page" [Draft, A, B, C]

2.  alice unstages p1
      bob    {p1}             "Page" [Draft, A, B, C]
      alice  {}               "Page" [A, B, C]   holds ?items [p1]

3.  alice edits p2: replace items/1/title = "B*"
      intent      rename "B" to "B*"
      picked in   "Page" [A, B, C]
      REFUSED     this section holds unstaged p1 (bob) — re-stage before editing here
      bob    {p1}             "Page" [Draft, A, B, C]
      alice  {}               "Page" [A, B, C]   holds ?items [p1]

if each author published now, from this same state:
  bob    commits [p1] — only their own work
         "Page" [Draft, A, B, C]
  alice  nothing staged"
`;

exports[`patch groups a region you have unstaged is read-only until you re-stage holding one region does not block edits in another 1`] = `
"scenario: Alice holds Bob's array work but edits the page title
module:   /content/page.val.ts
shape:    { title, items: [{ title }] }
base:     "Page" [A, B, C]
repair:   extend

1.  bob edits p1: add items/0 = {"title":"Draft"}
      intent      insert "Draft" at the top
      picked in   "Page" [A, B, C]
      patch sets  ?items [p1]
      bob    {p1}             "Page" [Draft, A, B, C]
      alice  {p1}             "Page" [Draft, A, B, C]

2.  alice unstages p1
      bob    {p1}             "Page" [Draft, A, B, C]
      alice  {}               "Page" [A, B, C]   holds ?items [p1]

3.  alice edits p2: replace title = "Page*"
      intent      retitle the page
      picked in   "Page" [A, B, C]
      patch sets  ?title [p2]   ?items [p1]
      bob    {p1, p2}         "Page*" [Draft, A, B, C]
      alice  {p2}             "Page*" [A, B, C]   holds ?items [p1]

4.  alice publishes [p2]
      bob's group loses the patches that were just committed
      new base    "Page*" [A, B, C]
      patch sets  ?items [p1]
      bob    {p1}             "Page*" [Draft, A, B, C]
      alice  {}               "Page*" [A, B, C]   holds ?items [p1]"
`;

exports[`patch groups patch sets stay sensible a move belongs to two patch sets and entangles both 1`] = `
"scenario: Alice moves an item between two arrays other people have edited
module:   /content/board.val.ts
shape:    { todo: [{ title }], done: [{ title }] }
base:     todo[T1, T2] done[D1]
repair:   extend

1.  bob edits p1: replace todo/0/title = "T1*"
      intent      rename "T1" to "T1*"
      picked in   todo[T1, T2] done[D1]
      patch sets  ?todo/0/title [p1]
      bob    {p1}             todo[T1*, T2] done[D1]
      carol  {p1}             todo[T1*, T2] done[D1]
      alice  {p1}             todo[T1*, T2] done[D1]

2.  carol edits p2: replace done/0/title = "D1*"
      intent      rename "D1" to "D1*"
      picked in   todo[T1*, T2] done[D1]
      patch sets  ?done/0/title [p2]   ?todo/0/title [p1]
      bob    {p1, p2}         todo[T1*, T2] done[D1*]
      carol  {p1, p2}         todo[T1*, T2] done[D1*]
      alice  {p1, p2}         todo[T1*, T2] done[D1*]

3.  alice edits p3: move done/1 from todo/1
      intent      move "T2" from todo to done
      picked in   todo[T1*, T2] done[D1*]
      patch sets  ?todo [p1, p3]   ?done [p2, p3]
      bob    {p1, p2, p3}     todo[T1*] done[D1*, T2]
      carol  {p1, p2, p3}     todo[T1*] done[D1*, T2]
      alice  {p1, p2, p3}     todo[T1*] done[D1*, T2]

if each author published now, from this same state:
  bob    commits [p1, p2, p3] — carries p2 (carol), p3 (alice)
         todo[T1*] done[D1*, T2]
  carol  commits [p1, p2, p3] — carries p1 (bob), p3 (alice)
         todo[T1*] done[D1*, T2]
  alice  commits [p1, p2, p3] — carries p1 (bob), p2 (carol)
         todo[T1*] done[D1*, T2]"
`;

