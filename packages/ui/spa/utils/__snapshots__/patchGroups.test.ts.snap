exports[`patch groups unstaging is what buys independence re-staging restores the region and the view 1`] = `
"scenario: Alice unstages Bob's insert and then changes her mind
module:   /content/page.val.ts
shape:    { title, items: [{ title }] }
base:     "Page" [A, B, C]
repair:   extend

1.  bob edits p1: add items/0 = {"title":"Draft"}
      intent      insert "Draft" at the top
      picked in   "Page" [A, B, C]
      patch sets  ?items [p1]
      bob    {p1}             "Page" [Draft, A, B, C]
      alice  {p1}             "Page" [Draft, A, B, C]

2.  alice unstages p1
      bob    {p1}             "Page" [Draft, A, B, C]
      alice  {}               "Page" [A, B, C]   holds ?items [p1]

3.  alice stages p1
      bob    {p1}             "Page" [Draft, A, B, C]
      alice  {p1}             "Page" [Draft, A, B, C]

4.  alice edits p2: replace items/2/title = "B*"
      intent      rename "B" to "B*"
      picked in   "Page" [Draft, A, B, C]
      patch sets  ?items [p1, p2]
      bob    {p1, p2}         "Page" [Draft, A, B*, C]
      alice  {p1, p2}         "Page" [Draft, A, B*, C]

5.  alice publishes [p1, p2]
      carries      p1 (bob)
      bob's group loses the patches that were just committed
      new base    "Page" [Draft, A, B*, C]
      patch sets  (none)
      bob    {}               "Page" [Draft, A, B*, C]
      alice  {}               "Page" [Draft, A, B*, C]"
`;

exports[`patch groups unstaging is what buys independence unstaging drops what was built on top of it, but not what came before 1`] = `
"scenario: Alice unstages an insert her own later edit depends on
module:   /content/page.val.ts
shape:    { title, items: [{ title }] }
base:     "Page" [A, B, C]
repair:   extend

1.  alice edits p1: replace title = "Page*"
      intent      retitle the page
      picked in   "Page" [A, B, C]
      patch sets  ?title [p1]
      alice  {p1}             "Page*" [A, B, C]
      bob    {p1}             "Page*" [A, B, C]

2.  bob edits p2: add items/0 = {"title":"Draft"}
      intent      insert "Draft" at the top
      picked in   "Page*" [A, B, C]
      patch sets  ?items [p2]   ?title [p1]
      alice  {p1, p2}         "Page*" [Draft, A, B, C]
      bob    {p1, p2}         "Page*" [Draft, A, B, C]

3.  alice edits p3: replace items/3/title = "C*"
      intent      rename "C" to "C*"
      picked in   "Page*" [Draft, A, B, C]
      patch sets  ?items [p2, p3]   ?title [p1]
      alice  {p1, p2, p3}     "Page*" [Draft, A, B, C*]
      bob    {p1, p2, p3}     "Page*" [Draft, A, B, C*]

4.  alice unstages p2
      also dropped p3 (alice) — they were built on top of it
      alice  {p1}             "Page*" [A, B, C]   holds ?items [p2,p3]
      bob    {p1, p2, p3}     "Page*" [Draft, A, B, C*]

5.  alice publishes [p1]
      bob's group loses the patches that were just committed
      new base    "Page*" [A, B, C]
      patch sets  ?items [p2, p3]
      alice  {}               "Page*" [A, B, C]   holds ?items [p2,p3]
      bob    {p2, p3}         "Page*" [Draft, A, B, C*]"
`;

