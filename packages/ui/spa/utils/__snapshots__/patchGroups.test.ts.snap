exports[`patch groups two authors edit the same scalar field the later edit wins and the earlier author's exact value does not survive 1`] = `
"scenario: Bob and Alice both retitle the page
module:   /content/page.val.ts
shape:    { title, items: [{ title }] }
base:     "Page" [A, B, C]
repair:   extend

1.  bob edits p1: replace title = "Bob was here"
      intent      have some page title of his own choosing
      patch sets  ?title [p1]
      bob    {p1}             "Bob was here" [A, B, C]
      alice  {}               "Page" [A, B, C]

2.  alice edits p2: replace title = "Alice was here"
      intent      set the page title to "Alice was here"
      patch sets  ?title [p1, p2]
      also staged p1 (bob) — required by p2
      bob    {p1}             "Bob was here" [A, B, C]
      alice  {p1, p2}         "Alice was here" [A, B, C]

if each author published now, from this same state:
  bob    commits [p1] — only their own work
         "Bob was here" [A, B, C]
  alice  commits [p1, p2] — carries p1 (bob)
         "Alice was here" [A, B, C]"
`;

