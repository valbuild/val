exports[`patch groups unstaging is what buys independence Bob can carry on and publish after Alice's commit 1`] = `
"scenario: Alice ships a title fix, then Bob finishes and ships the list
module:   /content/page.val.ts
shape:    { title, items: [{ title }] }
base:     "Page" [A, B, C]
repair:   extend

1.  bob edits p1: add items/0 = {"title":"Draft"}
      intent      insert "Draft" at the top
      picked in   "Page" [A, B, C]
      patch sets  ?items [p1]
      bob    {p1}             "Page" [Draft, A, B, C]
      alice  {p1}             "Page" [Draft, A, B, C]

2.  alice edits p2: replace title = "Page*"
      intent      retitle the page
      picked in   "Page" [Draft, A, B, C]
      patch sets  ?title [p2]   ?items [p1]
      bob    {p1, p2}         "Page*" [Draft, A, B, C]
      alice  {p1, p2}         "Page*" [Draft, A, B, C]

3.  alice unstages p1
      bob    {p1, p2}         "Page*" [Draft, A, B, C]
      alice  {p2}             "Page*" [A, B, C]   holds ?items [p1]

4.  alice publishes [p2]
      bob's group loses the patches that were just committed
      new base    "Page*" [A, B, C]
      patch sets  ?items [p1]
      bob    {p1}             "Page*" [Draft, A, B, C]
      alice  {}               "Page*" [A, B, C]   holds ?items [p1]

5.  bob edits p3: replace items/3/title = "C*"
      intent      rename "C" to "C*"
      picked in   "Page*" [Draft, A, B, C]
      patch sets  ?items [p1, p3]
      not staged for alice — they hold this region back
      bob    {p1, p3}         "Page*" [Draft, A, B, C*]
      alice  {}               "Page*" [A, B, C]   holds ?items [p1,p3]

6.  bob publishes [p1, p3]
      new base    "Page*" [Draft, A, B, C*]
      patch sets  (none)
      bob    {}               "Page*" [Draft, A, B, C*]
      alice  {}               "Page*" [Draft, A, B, C*]"
`;

