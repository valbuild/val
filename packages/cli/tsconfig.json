{
  "compilerOptions": {
    // es2022 for `Array.prototype.at`, which runValidation.test.ts uses. Under
    // es2020 this only typechecks by accident: meow 9 depends on type-fest,
    // whose types carry a `/// <reference lib="esnext" />` that leaks into this
    // program. Declare what the code actually needs instead of relying on that.
    "lib": ["es2022", "DOM"],
    "strict": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "module": "esnext",
    // `bundler`, not `node`: typechecking pulls in @valbuild/language-server's
    // source (via preconstruct dev), and vscode-languageserver 10 ships its
    // types behind an `exports` map that the legacy `node` resolver cannot see.
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "target": "ESNext",
    "resolveJsonModule": true
  }
}
