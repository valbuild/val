{
  "name": "@valbuild/cli",
  "private": false,
  "version": "0.120.0",
  "description": "Val CLI tools",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/valbuild/val.git"
  },
  "bin": {
    "val": "./bin.js"
  },
  "exports": {
    "./cli": {
      "module": "./cli/dist/valbuild-cli-cli.esm.js",
      "default": "./cli/dist/valbuild-cli-cli.cjs.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "start": "tsx src/cli.ts --",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@valbuild/core": "workspace:*",
    "@valbuild/eslint-plugin": "workspace:*",
    "@valbuild/language-server": "workspace:*",
    "@valbuild/server": "workspace:*",
    "@valbuild/shared": "workspace:*",
    "chalk": "^6.0.0",
    "chokidar": "^5.0.0",
    "fast-glob": "^3.3.3",
    "jszip": "^3.10.1",
    "meow": "^9.0.0",
    "picocolors": "^1.1.1"
  },
  "peerDependencies": {
    "prettier": "*",
    "typescript": ">=5.0.0"
  },
  "preconstruct": {
    "entrypoints": [
      "cli.ts"
    ]
  },
  "engines": {
    "node": "^22.13.0 || >=23.5.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.0",
    "tsx": "^4.23.12"
  }
}
