{
  "name": "@valbuild/server",
  "private": false,
  "description": "Val - integrated server",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/valbuild/val.git"
  },
  "main": "dist/valbuild-server.cjs.js",
  "module": "dist/valbuild-server.esm.js",
  "exports": {
    ".": {
      "module": "./dist/valbuild-server.esm.js",
      "default": "./dist/valbuild-server.cjs.js"
    },
    "./browser": {
      "module": "./browser/dist/valbuild-server-browser.esm.js",
      "default": "./browser/dist/valbuild-server-browser.cjs.js"
    },
    "./package.json": "./package.json"
  },
  "types": "dist/valbuild-server.cjs.d.ts",
  "preconstruct": {
    "entrypoints": [
      "./index.ts",
      "./browser/index.ts"
    ],
    "exports": true
  },
  "version": "0.150.20",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "@prettier/sync": "^0.6.1",
    "@types/jest": "^30.0.0",
    "prettier": "~3.8.5"
  },
  "dependencies": {
    "@valbuild/core": "workspace:*",
    "@valbuild/shared": "workspace:*",
    "@valbuild/ui": "workspace:*",
    "chokidar": "^5.0.0",
    "image-size": "^2.0.2",
    "minimatch": "^10.2.6",
    "sucrase": "^3.35.1",
    "typescript": "^6.0.3",
    "zod": "^4.4.3",
    "zod-validation-error": "^5.0.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "browser"
  ]
}
