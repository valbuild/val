{
  "compilerOptions": {
    "lib": ["es2020", "dom", "dom.iterable"],
    "types": ["node", "jest"],
    "strict": true,
    "isolatedModules": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "skipLibCheck": true
  },
  // Fixture projects are standalone mini val-projects: they are compiled by
  // the loader under test using their own tsconfig.json, not this one.
  "exclude": ["test/**/*", "src/__fixtures__/**/*"]
}
