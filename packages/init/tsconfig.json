{
  "compilerOptions": {
    "target": "es2016",
    // esnext + bundler so the `exports` maps of chalk 6, meow 14, diff 9 and
    // the @inquirer packages resolve. This config only drives `tsc --noEmit`;
    // preconstruct decides the emitted module format.
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    // Declared, not auto-discovered: TypeScript 6 no longer includes every
    // @types package it can find, so leaving this unset loses the node and
    // jest globals. The packages are still resolved through the default
    // typeRoots walk up to the workspace root.
    "types": ["node", "jest"],
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  }
}
