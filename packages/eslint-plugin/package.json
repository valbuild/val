{
  "name": "@valbuild/eslint-plugin",
  "version": "0.150.13",
  "description": "ESLint rules for val",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/valbuild/val.git"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "val",
    "valbuild"
  ],
  "main": "dist/valbuild-eslint-plugin.cjs.js",
  "module": "dist/valbuild-eslint-plugin.esm.js",
  "exports": {
    ".": {
      "module": "./dist/valbuild-eslint-plugin.esm.js",
      "default": "./dist/valbuild-eslint-plugin.cjs.js"
    },
    "./rules": {
      "module": "./rules/dist/valbuild-eslint-plugin-rules.esm.js",
      "default": "./rules/dist/valbuild-eslint-plugin-rules.cjs.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "license": "MIT",
  "peerDependencies": {
    "eslint": "^8.40.0 || ^9.0.0 || ^10.0.0",
    "typescript": "5 || 6"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@typescript-eslint/rule-tester": "^8.68.0",
    "eslint": "^10.9.1",
    "jest": "^30.5.0",
    "minimatch": "^10.2.6"
  },
  "scripts": {
    "test": "jest",
    "typecheck": "tsc -p jsconfig.json"
  },
  "preconstruct": {
    "entrypoints": [
      "./index.js",
      "./rules.js"
    ],
    "exports": true
  }
}
