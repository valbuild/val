{
  "compilerOptions": {
    // `dom`/`dom.iterable` are required even though this package is node-only:
    // typechecking pulls in @valbuild/server's source (via preconstruct dev),
    // which uses DOM types such as HeadersInit and the fetch Response types.
    // Matches packages/server/tsconfig.json.
    "lib": ["es2020", "dom", "dom.iterable"],
    "target": "es2020",
    "types": ["node", "jest"],
    "strict": true,
    "isolatedModules": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    // `bundler`, not `node`: vscode-languageserver 10 and vscode-jsonrpc 9 ship
    // their types behind an `exports` map, which the legacy `node` resolver
    // cannot see — it reports "Cannot find module 'vscode-languageserver'" while
    // pointing at the .d.ts it just declined to use. `bundler` reads `exports`
    // and, unlike node16/nodenext, does not require extensions on relative
    // imports, which suits a package preconstruct bundles anyway.
    "moduleResolution": "bundler",
    "skipLibCheck": true
  }
}
