{
  "compilerOptions": {
    // `dom`/`dom.iterable` are required even though this package is node-only:
    // typechecking pulls in @valbuild/server's source (via preconstruct dev),
    // which uses DOM types such as HeadersInit and the fetch Response types.
    // Matches packages/server/tsconfig.json.
    "lib": ["es2020", "dom", "dom.iterable"],
    "target": "es2020",
    "types": ["node", "jest"],
    "strict": true,
    "isolatedModules": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "skipLibCheck": true
  }
}
