{
  "compilerOptions": {
    "esModuleInterop": true,
    // Declared, not auto-discovered: TypeScript 6 no longer includes every
    // @types package it can find, so leaving this unset loses the node and
    // jest globals. The packages are still resolved through the default
    // typeRoots walk up to the workspace root.
    "types": ["node", "jest"],
    "strict": true,
    "allowJs": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    // es2022, not es6: this package typechecks @valbuild/server's source through
    // preconstruct's dev links, and that source uses the
    // `new Error(message, { cause })` overload eslint 10 asks for.
    "lib": ["es2022", "dom"],
    "module": "ESNext",
    // `bundler`, not `node`: TypeScript 6 deprecates the node10 resolver and
    // TypeScript 7 removes it. `bundler` reads `exports` maps and, unlike
    // node16/nodenext, does not require extensions on relative imports.
    "moduleResolution": "bundler",
    "noEmit": true,
    "target": "ES2017",
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["dist/**"]
}
