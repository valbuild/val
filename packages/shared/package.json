{
  "name": "@valbuild/shared",
  "version": "0.150.3",
  "private": false,
  "description": "Val shared types and utilities",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/valbuild/val.git"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "main": "dist/valbuild-shared.cjs.js",
  "module": "dist/valbuild-shared.esm.js",
  "exports": {
    ".": {
      "module": "./dist/valbuild-shared.esm.js",
      "default": "./dist/valbuild-shared.cjs.js"
    },
    "./client": {
      "module": "./client/dist/valbuild-shared-client.esm.js",
      "default": "./client/dist/valbuild-shared-client.cjs.js"
    },
    "./publish": {
      "module": "./publish/dist/valbuild-shared-publish.esm.js",
      "default": "./publish/dist/valbuild-shared-publish.cjs.js"
    },
    "./internal": {
      "module": "./internal/dist/valbuild-shared-internal.esm.js",
      "default": "./internal/dist/valbuild-shared-internal.cjs.js"
    },
    "./typecheck": {
      "module": "./typecheck/dist/valbuild-shared-typecheck.esm.js",
      "default": "./typecheck/dist/valbuild-shared-typecheck.cjs.js"
    },
    "./typecheck/testing": {
      "module": "./typecheck/testing/dist/valbuild-shared-typecheck-testing.esm.js",
      "default": "./typecheck/testing/dist/valbuild-shared-typecheck-testing.cjs.js"
    },
    "./package.json": "./package.json"
  },
  "types": "dist/valbuild-shared.cjs.d.ts",
  "preconstruct": {
    "entrypoints": [
      "./index.ts",
      "./client/index.ts",
      "./internal/index.ts",
      "./publish/index.ts",
      "./typecheck/index.ts",
      "./typecheck/testing/index.ts"
    ],
    "exports": true
  },
  "dependencies": {
    "@valbuild/core": "workspace:*",
    "flexsearch": "^0.8.212",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "zod-validation-error": "^5.0.0"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "client/dist",
    "client/package.json",
    "internal/dist",
    "internal/package.json",
    "publish/dist",
    "publish/package.json",
    "typecheck/dist",
    "typecheck/package.json",
    "typecheck/testing/dist",
    "typecheck/testing/package.json"
  ],
  "devDependencies": {
    "typescript": "^6.0.3",
    "@valbuild/tanstack-build": "workspace:*"
  },
  "sideEffects": false
}
